{
  "name": "@gltf-transform/cli",
  "version": "4.3.0",
  "repository": "github:donmccurdy/glTF-Transform",
  "homepage": "https://gltf-transform.dev/cli.html",
  "description": "CLI interface to glTF Transform",
  "author": "Don McCurdy <dm@donmccurdy.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/donmccurdy",
  "type": "module",
  "types": "./dist/cli.d.mts",
  "exports": {
    "types": "./dist/cli.d.mts",
    "default": "./dist/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown src/cli.ts --format esm --env.PACKAGE_VERSION=$npm_package_version",
    "build:watch": "tsdown src/cli.ts --watch --format esm --env.PACKAGE_VERSION=$npm_package_version",
    "package:win": "caxa --input . --output ./dist/gltf-transform.exe -- \"{{caxa}}/node_modules/.bin/node\" \"{{caxa}}/bin/cli.js\"",
    "package:linux": "caxa --input . --output ./dist/gltf-transform -- \"{{caxa}}/node_modules/.bin/node\" \"{{caxa}}/bin/cli.js\"",
    "package:mac": "caxa --input . --output ./dist/glTF-Transform.app -- \"{{caxa}}/node_modules/.bin/node\" \"{{caxa}}/bin/cli.js\""
  },
  "bin": {
    "gltf-transform": "./bin/cli.js"
  },
  "dependencies": {
    "@donmccurdy/caporal": "~0.0.10",
    "@gltf-transform/core": "file:../core/gltf-transform-core-4.3.0.tgz",
    "@gltf-transform/extensions": "file:../extensions/gltf-transform-extensions-4.3.0.tgz",
    "@gltf-transform/functions": "file:../functions/gltf-transform-functions-4.3.0.tgz",
    "@types/language-tags": "~1.0.4",
    "@types/micromatch": "~4.0.10",
    "@types/node-fetch": "~2.6.13",
    "@types/prompts": "^2.4.9",
    "@types/tmp": "~0.2.6",
    "cli-table3": "~0.6.5",
    "csv-stringify": "~6.6.0",
    "draco3dgltf": "~1.5.7",
    "gl-matrix": "^3.4.4",
    "gltf-validator": "~2.0.0-dev.3.10",
    "keyframe-resample": "~0.1.0",
    "ktx-parse": "^1.1.0",
    "language-tags": "^1.0.9",
    "listr2": "~8.3.3",
    "meshoptimizer": "~1.0.1",
    "micromatch": "~4.0.8",
    "mikktspace": "~1.1.1",
    "node-fetch": "~3.3.2",
    "p-limit": "~6.2.0",
    "prompts": "^2.4.2",
    "sharp": "~0.34.5",
    "tmp": "~0.2.5",
    "watlas": "^1.0.1"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "README.md",
    "LICENSE.md",
    "package-lock.json"
  ],
  "devDependencies": {
    "caxa": "^3.0.1",
    "tsdown": "^0.21.10"
  },
  "gitHead": "895b70777fda68aa321358d17dab2105e8564d08"
}
